# MANUAL: Web OAuth client ID from Firebase/Google Cloud, never Android OAuth client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# MANUAL: Match the deployed Cloud Functions region.
EXPO_PUBLIC_FIREBASE_REGION=asia-south1
# MANUAL: Debug builds only. Register a generated token in Firebase App Check Console.
# Do not commit real tokens; release always uses Play Integrity.
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=
